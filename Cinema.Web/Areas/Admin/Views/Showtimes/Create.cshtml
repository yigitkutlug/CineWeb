@* Admin seans ekleme formu: film + salon + tarih/saat + fiyat *@
@model Cinema.Web.Areas.Admin.ViewModels.ShowtimeFormVm
@{
    ViewData["Title"] = "Seans Ekle";
}

<div class="admin-panel">
    <div class="admin-panel-header">
        <h2>Seans Ekle - @Model.MovieTitle</h2>
        <a class="btn btn-sm btn-outline-light" asp-area="Admin" asp-controller="Showtimes" asp-action="Index" asp-route-movieId="@Model.MovieId">Listeye Don</a>
    </div>
    <div class="admin-panel-body">
        <form method="post" class="admin-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MovieId" />
            <input type="hidden" asp-for="MovieTitle" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger validation-summary-valid py-2"></div>
            }

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="HallId" class="form-label admin-form-label"></label>
                    <select asp-for="HallId" asp-items="Model.HallOptions" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="StartsAt" class="form-label admin-form-label"></label>
                    <input asp-for="StartsAt" type="datetime-local" class="form-control"
                           value="@Model.StartsAt.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Price" class="form-label admin-form-label"></label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive">Aktif</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning">Kaydet</button>
                <a class="btn btn-outline-light" asp-area="Admin" asp-controller="Showtimes" asp-action="Index" asp-route-movieId="@Model.MovieId">Iptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var hallSelect = document.querySelector('[name="HallId"]');
            var priceInput = document.querySelector('[name="Price"]');
            if (!hallSelect || !priceInput) return;

            function applyVipPrice() {
                var selected = hallSelect.options[hallSelect.selectedIndex];
                var text = selected ? selected.text.toLowerCase() : '';
                if (text.includes('vip')) {
                    priceInput.value = '600';
                }
            }

            hallSelect.addEventListener('change', applyVipPrice);
        })();
    </script>
}

