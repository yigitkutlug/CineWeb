@* Admin oyuncu ekleme formu *@
@model Cinema.Web.Areas.Admin.ViewModels.ActorFormVm
@{
    ViewData["Title"] = "Oyuncu Ekle";
}

<div class="admin-panel">
    <div class="admin-panel-header">
        <h2>Yeni Oyuncu Ekle</h2>
        <a class="btn btn-sm btn-outline-light" asp-area="Admin" asp-controller="Actors" asp-action="Index">Listeye Don</a>
    </div>
    <div class="admin-panel-body">
        <form method="post" enctype="multipart/form-data" class="admin-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger validation-summary-valid py-2"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="FirstName" class="form-label admin-form-label">Ad</label>
                    <input asp-for="FirstName" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="LastName" class="form-label admin-form-label">Soyad</label>
                    <input asp-for="LastName" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Nationality" class="form-label admin-form-label">Uyruk</label>
                    <input asp-for="Nationality" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="BirthDate" class="form-label admin-form-label">Dogum Tarihi</label>
                    <input asp-for="BirthDate" class="form-control" type="date" />
                </div>
                <div class="col-md-9">
                    <label class="form-label admin-form-label" for="photoFile">Oyuncu Fotografi (Dosya Sec)</label>
                    <input type="file" id="photoFile" name="photoFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/*" />
                    <span asp-validation-for="PhotoPath" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Biography" class="form-label admin-form-label">Biyografi</label>
                    <textarea asp-for="Biography" class="form-control" rows="4" placeholder="Oyuncu hakkinda kisa bilgi..."></textarea>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning">Kaydet</button>
                <a class="btn btn-outline-light" asp-area="Admin" asp-controller="Actors" asp-action="Index">Iptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


