@model List<Cinema.Application.Reviews.ReviewAdminItemDto>
@{
    ViewData["Title"] = "Yorum Onay";
}

<div class="admin-panel">
    <div class="admin-panel-header">
        <div>
            <h2>Bekleyen Yorumlar</h2>
            <div class="text-secondary">Sadece onay bekleyenler</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-light" asp-area="Admin" asp-controller="Reviews" asp-action="Moderation">Yorum Moderasyon</a>
        </div>
    </div>
    <div class="admin-panel-body">
        @if (!Model.Any())
        {
            <div class="admin-empty">Onay bekleyen yorum yok.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table">
                    <thead>
                        <tr>
                            <th>Film</th>
                            <th>Kullanici</th>
                            <th>Puan</th>
                            <th>Yorum</th>
                            <th>Tarih</th>
                            <th class="text-end">Islem</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MovieTitle</td>
                            <td>
                                <a asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@item.UserId">
                                    @item.DisplayName
                                </a>
                            </td>
                            <td>@item.Rating / 5</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Comment) ? "-" : item.Comment)</td>
                            <td>@item.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <form method="post" asp-action="Approve" asp-route-id="@item.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">Onayla</button>
                                    </form>
                                    <form method="post" asp-action="Reject" asp-route-id="@item.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reddet</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
