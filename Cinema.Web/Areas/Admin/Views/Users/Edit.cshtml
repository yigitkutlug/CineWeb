@* SuperAdmin uye duzenleme: Identity + profil alanlari + roller ayni formda *@
@model Cinema.Web.Areas.Admin.ViewModels.UserEditVm
@{
    ViewData["Title"] = "Uye Duzenle";
}

<div class="admin-panel">
    <div class="admin-panel-header">
        <h2>Uye Duzenle</h2>
        <a class="btn btn-sm btn-outline-light" asp-area="Admin" asp-controller="Users" asp-action="Index">Listeye Don</a>
    </div>

    <div class="admin-panel-body">
        <form method="post" class="admin-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger validation-summary-valid py-2 mb-3"></div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label admin-form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label admin-form-label">Telefon</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="FirstName" class="form-label admin-form-label">Ad</label>
                    <input asp-for="FirstName" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="LastName" class="form-label admin-form-label">Soyad</label>
                    <input asp-for="LastName" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="City" class="form-label admin-form-label">Sehir</label>
                    <input asp-for="City" class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label admin-form-label">Adres</label>
                    <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-12">
                    <label asp-for="ProfilePhotoPath" class="form-label admin-form-label">Profil Fotografi Yolu / URL</label>
                    <input asp-for="ProfilePhotoPath" class="form-control" placeholder="/uploads/profiles/..." />
                    <div class="form-text text-secondary">Kullanici kendi profil ekranindan dosya yukleyebilir; burada istersen URL/path girebilirsin.</div>
                </div>
            </div>

            <hr class="border-secondary-subtle my-4" />

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="IsAdmin" />
                        <label class="form-check-label" asp-for="IsAdmin">Admin rolunu ver</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="IsSuperAdmin" />
                        <label class="form-check-label" asp-for="IsSuperAdmin">SuperAdmin rolunu ver</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning">Kaydet</button>
                <a class="btn btn-outline-light" asp-area="Admin" asp-controller="Users" asp-action="Index">Iptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

