@* Public film listesi: tüm filmler kart formatında listelenir *@
@model List<Cinema.Domain.Entities.Movie>
@{
    ViewData["Title"] = "Filmler";
}

<style>
    .movies-page {
        max-width: 1180px;
        margin-inline: auto;
        color: #edf2ff;
    }

    .movies-hero {
        position: relative;
        overflow: hidden;
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,.08);
        background:
            radial-gradient(circle at 12% 15%, rgba(212,162,76,.14), transparent 35%),
            radial-gradient(circle at 86% 16%, rgba(91,118,255,.12), transparent 36%),
            linear-gradient(145deg, rgba(12,15,22,.92), rgba(16,22,33,.86));
        box-shadow: 0 20px 46px rgba(0,0,0,.22);
        padding: 1.35rem;
    }

    .movies-hero h1 {
        margin: 0 0 .55rem;
        font-size: clamp(1.8rem, 4vw, 2.7rem);
        font-weight: 800;
        letter-spacing: -.02em;
    }

    .movies-hero p {
        margin: 0;
        color: #c5cee2;
        max-width: 68ch;
        line-height: 1.6;
    }

    .movie-toolbar {
        margin-top: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        color: #cbd4e9;
    }

    .movie-toolbar .count-pill {
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.03);
        padding: .35rem .7rem;
        font-size: .9rem;
    }

    .movie-grid {
        margin-top: 1rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .movie-card {
        display: flex;
        flex-direction: column;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.08);
        background: linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.015));
        box-shadow: 0 14px 32px rgba(0,0,0,.15);
    }

    .movie-card:hover {
        border-color: rgba(212,162,76,.25);
        transform: translateY(-2px);
        transition: .2s ease;
    }

    .movie-poster {
        aspect-ratio: 2 / 3;
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid rgba(255,255,255,.06);
        background:
            radial-gradient(circle at 18% 18%, rgba(212,162,76,.22), transparent 40%),
            radial-gradient(circle at 86% 22%, rgba(91,118,255,.18), transparent 38%),
            linear-gradient(135deg, #242c3d, #141a27);
    }

    .movie-poster img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .movie-card:nth-child(2n) .movie-poster {
        background:
            radial-gradient(circle at 18% 18%, rgba(255,107,74,.18), transparent 40%),
            radial-gradient(circle at 86% 22%, rgba(212,162,76,.15), transparent 38%),
            linear-gradient(135deg, #332127, #17131c);
    }

    .movie-card:nth-child(3n) .movie-poster {
        background:
            radial-gradient(circle at 18% 18%, rgba(56,192,165,.18), transparent 40%),
            radial-gradient(circle at 86% 22%, rgba(91,118,255,.14), transparent 38%),
            linear-gradient(135deg, #1d3132, #111821);
    }

    .movie-badge {
        position: absolute;
        top: .75rem;
        left: .75rem;
        z-index: 1;
        border-radius: 999px;
        padding: .25rem .55rem;
        font-size: .75rem;
        font-weight: 700;
        border: 1px solid rgba(255,255,255,.14);
        background: rgba(10,12,18,.45);
        color: #eef3ff;
    }

    .movie-badge.featured {
        border-color: rgba(212,162,76,.35);
        background: rgba(212,162,76,.14);
        color: #f7dfa8;
    }

    .movie-card-body {
        padding: .95rem;
        display: grid;
        gap: .65rem;
        flex: 1;
    }

    .movie-title {
        margin: 0;
        font-weight: 800;
        font-size: 1.05rem;
        color: #f2f6ff;
    }

    .movie-meta {
        margin: 0;
        color: #bfc9de;
        font-size: .92rem;
    }

    .movie-actions {
        display: flex;
        gap: .5rem;
        margin-top: .15rem;
    }

    .btn-movie-primary, .btn-movie-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        padding: .6rem .8rem;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid transparent;
    }

    .btn-movie-primary {
        color: #1a1205;
        background: linear-gradient(135deg, #d4a24c, #e8c37b);
    }

    .btn-movie-secondary {
        color: #eef3ff;
        background: rgba(255,255,255,.03);
        border-color: rgba(255,255,255,.10);
    }

    .empty-state {
        margin-top: 1rem;
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.02);
        padding: 1.2rem;
        color: #c4cde0;
    }

    @@media (max-width: 991px) {
        .movie-grid { grid-template-columns: 1fr 1fr; }
        .movie-poster { aspect-ratio: 2 / 3; }
    }

    @@media (max-width: 575px) {
        .movie-grid { grid-template-columns: 1fr; }
        .movie-actions { flex-direction: column; }
        .movie-poster { aspect-ratio: 2 / 3; }
    }
</style>

<section class="movies-page">
    <div class="movies-hero">
        <h1>Vizyondaki Filmler</h1>
        <p>
            Sinema keyfini yaşamak için filmleri keşfet, detaylarını incele ve seansını seçerek
            biletini oluştur. Giriş yapan kullanıcıların biletleri profilindeki <strong>Biletlerim</strong> alanına kaydedilir.
        </p>
    </div>

    <div class="movie-toolbar">
        <div class="count-pill">Toplam @Model.Count film</div>
        <div>Öne çıkan filmler üstte listelenir</div>
    </div>

    @* Model bos ise "empty state" gosterilir *@
    @if (!Model.Any())
    {
        <div class="empty-state">
            Henüz film eklenmemiş. Admin panelinden film ekledikten sonra burada listelenecek.
        </div>
    }
    else
    {
        @* Liste: her film kart + rozet + aksiyon butonlari *@
        <div class="movie-grid">
            @foreach (var movie in Model)
            {
                <article class="movie-card">
                    <div class="movie-poster">
                        <span class="movie-badge @(movie.IsFeatured ? "featured" : "")">
                            @(movie.IsFeatured ? "Öne Çıkan" : "Vizyonda")
                        </span>
                        @if (!string.IsNullOrWhiteSpace(movie.PosterImagePath))
                        {
                            <img src="@movie.PosterImagePath" alt="@movie.Title afişi" loading="lazy" />
                        }
                    </div>

                    <div class="movie-card-body">
                        <div>
                            <h2 class="movie-title">@movie.Title</h2>
                            <p class="movie-meta">
                                @(string.IsNullOrWhiteSpace(movie.Genre) ? "Tür belirtilmedi" : movie.Genre)
                                • @movie.DurationMinutes dk
                            </p>
                        </div>

                        <div class="movie-actions">
                            <a class="btn-movie-secondary flex-fill"
                               asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id">
                                Detay
                            </a>
                            <a class="btn-movie-primary flex-fill"
                               asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id">
                                Bilet Al
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>
