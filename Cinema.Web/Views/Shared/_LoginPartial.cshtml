@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@* Navbar sag taraftaki login/logout blogu *@
<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    @* Giriş yapıldıysa profil ve bilet geçmişi linkleri de göster *@
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-controller="Profile" asp-action="Index">Profilim</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-controller="Profile" asp-action="Tickets">Biletlerim</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
            Merhaba @User.Identity?.Name
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline"
              asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
              method="post">
            <button type="submit" class="nav-link btn btn-link">Çıkış</button>
        </form>
    </li>
}
else
{
    @* Giriş yapılmadıysa kayıt/giriş linklerini göster *@
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Kayıt Ol</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Giriş</a>
    </li>
}
</ul>
