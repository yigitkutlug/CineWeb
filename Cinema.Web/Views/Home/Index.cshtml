@* Public ana sayfa: hero, öne çıkan filmler, özellikler ve CTA bölümü *@
@model Cinema.Web.ViewModels.HomePageVm
@{
    ViewData["Title"] = "Ana Sayfa";
}

<style>
    .cinema-home {
        --bg: #0f1117;
        --panel: #171a23;
        --panel-2: #1f2330;
        --text: #f5f1e8;
        --muted: #b8b2a7;
        --accent: #d4a24c;
        --accent-2: #ff6b4a;
        --line: rgba(255,255,255,.08);
        color: var(--text);
        margin-top: -1rem;
        margin-bottom: 2rem;
    }

    .cinema-home a { text-decoration: none; }

    .cinema-hero {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 3rem 2rem;
        background:
            radial-gradient(circle at 80% 10%, rgba(212,162,76,.35), transparent 40%),
            radial-gradient(circle at 15% 20%, rgba(255,107,74,.18), transparent 45%),
            linear-gradient(135deg, #11141c 0%, #0b0d12 60%, #17131a 100%);
        border: 1px solid var(--line);
        box-shadow: 0 20px 60px rgba(0,0,0,.35);
    }

    .film-grain {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
        background-size: 4px 4px, 4px 4px;
        pointer-events: none;
        opacity: .45;
    }

    .hero-grid {
        position: relative;
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 1.5rem;
        align-items: center;
    }

    .kicker {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .35rem .7rem;
        border-radius: 999px;
        border: 1px solid rgba(212,162,76,.35);
        background: rgba(212,162,76,.08);
        color: #f1d7a0;
        font-size: .85rem;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .hero-title {
        margin: 1rem 0 .75rem;
        font-size: clamp(2rem, 5vw, 3.8rem);
        line-height: 1.02;
        font-weight: 800;
        letter-spacing: -.03em;
    }

    .hero-title span {
        color: var(--accent);
        text-shadow: 0 0 24px rgba(212,162,76,.25);
    }

    .hero-text {
        color: var(--muted);
        max-width: 60ch;
        font-size: 1rem;
        line-height: 1.6;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 1.25rem;
    }

    .cta-primary, .cta-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        padding: .8rem 1rem;
        font-weight: 700;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

    .cta-primary {
        background: linear-gradient(135deg, var(--accent), #e0b96b);
        color: #1b1205;
        box-shadow: 0 10px 20px rgba(212,162,76,.25);
    }

    .cta-secondary {
        background: rgba(255,255,255,.03);
        color: var(--text);
        border: 1px solid var(--line);
    }

    .cta-primary:hover, .cta-secondary:hover {
        transform: translateY(-2px);
    }

    .showcase-card {
        position: relative;
        border-radius: 18px;
        border: 1px solid var(--line);
        background: linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.01));
        padding: 1rem;
        backdrop-filter: blur(6px);
    }

    .poster-stack {
        display: grid;
        gap: .75rem;
    }

    .poster {
        border-radius: 14px;
        padding: .85rem;
        border: 1px solid rgba(255,255,255,.07);
        background: linear-gradient(135deg, #222838, #141824);
    }

    .poster:nth-child(2) { background: linear-gradient(135deg, #2a2220, #17141b); }
    .poster:nth-child(3) { background: linear-gradient(135deg, #1f2e2f, #11161c); }

    .poster h3 {
        margin: 0 0 .35rem;
        font-size: 1rem;
        color: var(--text);
    }

    .poster p {
        margin: 0;
        color: var(--muted);
        font-size: .9rem;
    }

    .home-section {
        margin-top: 1.25rem;
        border-radius: 20px;
        background: linear-gradient(180deg, #11141b, #0c0f15);
        border: 1px solid var(--line);
        padding: 1.2rem;
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: .8rem;
    }

    .section-head h2 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: .02em;
    }

    .section-head span {
        color: var(--muted);
        font-size: .9rem;
    }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .9rem;
    }

    .movie-card {
        border-radius: 16px;
        overflow: hidden;
        background: var(--panel);
        border: 1px solid var(--line);
    }

    .movie-thumb {
        aspect-ratio: 2 / 3;
        height: auto;
        background:
            linear-gradient(135deg, rgba(212,162,76,.35), transparent 55%),
            linear-gradient(135deg, #2a2f40, #1a1e2b);
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .movie-thumb img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: #0f1117;
    }

    .movie-card:nth-child(2) .movie-thumb {
        background:
            linear-gradient(135deg, rgba(255,107,74,.28), transparent 55%),
            linear-gradient(135deg, #362227, #1d161b);
    }

    .movie-card:nth-child(3) .movie-thumb {
        background:
            linear-gradient(135deg, rgba(76,182,212,.22), transparent 55%),
            linear-gradient(135deg, #1f3138, #10171d);
    }

    .movie-body {
        padding: .9rem;
    }

    .movie-title {
        margin: 0 0 .35rem;
        font-weight: 700;
    }

    .movie-meta {
        margin: 0;
        color: var(--muted);
        font-size: .9rem;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .8rem;
        margin-top: .8rem;
    }

    .feature-card {
        background: var(--panel-2);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: .9rem;
    }

    .feature-card strong {
        display: block;
        margin-bottom: .35rem;
        font-size: .95rem;
    }

    .feature-card p {
        margin: 0;
        color: var(--muted);
        font-size: .88rem;
        line-height: 1.45;
    }

    .bottom-cta {
        margin-top: 1.25rem;
        border-radius: 20px;
        border: 1px solid rgba(212,162,76,.25);
        background:
            radial-gradient(circle at 15% 20%, rgba(212,162,76,.14), transparent 45%),
            linear-gradient(135deg, #17130f, #0f1117);
        padding: 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .bottom-cta h3 {
        margin: 0 0 .25rem;
        font-size: 1.15rem;
    }

    .bottom-cta p {
        margin: 0;
        color: var(--muted);
    }

    @@media (max-width: 991px) {
        .hero-grid { grid-template-columns: 1fr; }
        .movie-grid { grid-template-columns: 1fr; }
        .feature-grid { grid-template-columns: 1fr 1fr; }
    }

    @@media (max-width: 575px) {
        .cinema-hero { padding: 1.25rem; border-radius: 18px; }
        .home-section, .bottom-cta { padding: 1rem; border-radius: 16px; }
        .feature-grid { grid-template-columns: 1fr; }
        .bottom-cta { flex-direction: column; align-items: flex-start; }
        .movie-thumb { aspect-ratio: 2 / 3; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cta-primary, .cta-secondary { transition: none; }
    }
</style>

<section class="cinema-home">
    <div class="cinema-hero">
        <div class="film-grain"></div>
        <div class="hero-grid">
            <div>
                <div class="kicker">Sinema Deneyimi</div>
                <h1 class="hero-title">Perde Açılıyor, <span>Hikaye Başlıyor</span></h1>
                <p class="hero-text">
                    En yeni filmler, konforlu salonlar ve etkileyici ses sistemiyle sinema keyfini tek bir yerde topla.
                    Seansını seç, koltuğunu ayır, filmini kaçırma.
                </p>
                <div class="hero-actions">
                    <a class="cta-primary" asp-controller="Movies" asp-action="Index">Seansları Keşfet</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="cta-secondary" asp-controller="Profile" asp-action="Index">Profilim</a>
                    }
                    else
                    {
                        <a class="cta-secondary" asp-area="Identity" asp-page="/Account/Login">Hemen Giriş Yap</a>
                    }
                </div>
            </div>

            <div class="showcase-card">
                <div class="poster-stack">
                    @if (Model.UpcomingShowtimes.Any())
                    {
                        @foreach (var showtime in Model.UpcomingShowtimes)
                        {
                            var localTime = DateTime.SpecifyKind(showtime.StartsAtUtc, DateTimeKind.Utc).ToLocalTime();
                            <div class="poster">
                                <h3>@showtime.MovieTitle</h3>
                                <p>@localTime.ToString("dd.MM.yyyy HH:mm") - @showtime.HallName - @showtime.Price.ToString("0.00") TL</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="poster">
                            <h3>Yaklasan seans yok</h3>
                            <p>Yeni seanslar eklendiginde burada listelenecek.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="home-section" id="one-cikan-filmler">
        <div class="section-head">
            <h2>Öne Çıkan Filmler</h2>
            <span>Bu hafta salonda</span>
        </div>

        @if (Model != null && Model.FeaturedMovies.Any())

        {
            <div class="movie-grid">
                @foreach (var movie in Model.FeaturedMovies)
                {
                    <article class="movie-card">
                        <div class="movie-thumb">
                            @if (!string.IsNullOrWhiteSpace(movie.PosterImagePath))
                            {
                                <img src="@movie.PosterImagePath" alt="@movie.Title afişi" loading="lazy" />
                            }
                        </div>
                        <div class="movie-body">
                            <p class="movie-title">@movie.Title</p>
                            <p class="movie-meta">@(string.IsNullOrWhiteSpace(movie.Genre) ? "Tür belirtilmedi" : movie.Genre) - @movie.DurationMinutes dk</p>
                            <a class="cta-secondary"
                               style="margin-top:.5rem; display:inline-flex;"
                               asp-controller="Movies"
                               asp-action="Details"
                               asp-route-id="@movie.Id">Filme Git</a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="feature-card">
                <strong>Henüz film eklenmemiş</strong>
                <p>Yönetim panelinden film eklediğinizde bu alan otomatik güncellenecek.</p>
            </div>
        }
    </div>

    <div class="home-section">
        <div class="section-head">
            <h2>Neden Biz?</h2>
            <span>Konfor + teknoloji + hızlı işlem</span>
        </div>

        <div class="feature-grid">
            <div class="feature-card">
                <strong>Premium Koltuklar</strong>
                <p>Uzun filmlerde bile rahat oturum için geniş ve ergonomik koltuklar.</p>
            </div>
            <div class="feature-card">
                <strong>Dolby Atmos</strong>
                <p>Sahnenin içine alan surround ses deneyimi ile daha güçlü atmosfer.</p>
            </div>
            <div class="feature-card">
                <strong>Hızlı Biletleme</strong>
                <p>Online seçim, hızlı giriş ve daha az bekleme ile kolay rezervasyon.</p>
            </div>
            <div class="feature-card">
                <strong>VIP Salon</strong>
                <p>Özel servis ve sinema keyfini yükselten daha sessiz premium alan.</p>
            </div>
        </div>
    </div>

    <div class="bottom-cta">
        <div>
            <h3>Hazırsan bir sonraki seans seni bekliyor</h3>
            <p>Hesabına giriş yap ve bilet işlemlerini hızlıca tamamla.</p>
        </div>
        <a class="cta-primary" asp-area="Identity" asp-page="/Account/Register">Üye Ol / Bilet Al</a>
    </div>
</section>
