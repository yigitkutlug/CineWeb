@* Gizlilik politikasi: statik bilgilendirme metni *@
@{
    ViewData["Title"] = "Gizlilik";
}

<section style="max-width:900px;margin-inline:auto;color:#eef2fb;">
    <div style="border-radius:22px;border:1px solid rgba(255,255,255,.08);background:linear-gradient(145deg, rgba(13,16,24,.92), rgba(16,21,33,.88));box-shadow:0 20px 50px rgba(0,0,0,.2);padding:1.5rem;">
        <h1 style="margin:0 0 .75rem;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:800;">Gizlilik Politikası</h1>
        <p style="color:#c5cde0;line-height:1.7;">
            CinemaSystem, kullanıcı deneyimini geliştirmek ve oturum işlemlerini güvenli şekilde yürütmek için
            gerekli olan temel verileri işler. Kişisel bilgileriniz, yetkisiz erişime karşı korunur ve yalnızca
            hizmetin çalışması için gereken kapsamda kullanılır.
        </p>
        <p style="color:#c5cde0;line-height:1.7;margin-bottom:0;">
            Profil bilgileri, bilet geçmişi ve iletişim formları üzerinden paylaştığınız içerikler; hizmet kalitesini
            artırmak, destek taleplerini yönetmek ve hesap güvenliğini sağlamak amacıyla değerlendirilir.
        </p>
    </div>
</section>
