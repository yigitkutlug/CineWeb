{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=your-host;Port=5432;Database=your-db;Username=your-username;Password=your-password",
    "AppDbContextConnection": "Server=(localdb)\\mssqllocaldb;Database=Cinema.Web;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Seed": {
    "SuperAdminEmail": "your-superadmin-email@example.com",
    "SuperAdminPassword": "your-superadmin-password"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Cinema System",
    "SenderEmail": "your-sender-email@example.com",
    "Username": "your-smtp-username",
    "Password": "your-smtp-password",
    "EnableSsl": true
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "CHANGE_ME__AT_LEAST_32_CHARS_LONG_SECRET",
    "Issuer": "Cinema.Web",
    "Audience": "Cinema.Web",
    "ExpiryMinutes": 60
  }
}
